generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DocumentType {
  PUBLIC
  INTERNAL
  FRANCHISE
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

model Category {
  id          String      @id @default(cuid())
  name        String
  description String?
  parentId    String?
  parent      Category?   @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[]  @relation("SubCategories")
  createdAt   DateTime    @default(now())
  documents   Document[]
  faqs        Faq[]
}

model Document {
  id         String       @id @default(cuid())
  title      String
  content    String
  type       DocumentType @default(PUBLIC)
  categoryId String?
  category   Category?    @relation(fields: [categoryId], references: [id])
  fileUrl    String?
  embedding  Unsupported("vector(1024)")?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Faq {
  id         String    @id @default(cuid())
  question   String
  answer     String
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  published  Boolean   @default(false)
  order      Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model History {
  id               String   @id @default(cuid())
  sessionToken     String
  userMessage      String
  assistantMessage String
  documentsUsed    String[]
  createdAt        DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebSource {
  id          String    @id @default(cuid())
  name        String
  url         String    @unique
  maxPages    Int       @default(80)
  active      Boolean   @default(true)
  lastCrawled DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  pages       WebPage[]
}

model WebPage {
  id        String                      @id @default(cuid())
  url       String                      @unique
  title     String
  content   String
  embedding Unsupported("vector(1024)")?
  sourceId  String
  source    WebSource                   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  crawledAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt
}
