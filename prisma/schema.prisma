generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DocumentType {
  PUBLIC
  INTERNAL
  FRANCHISE
}

// Traitement d'un document importé : lecture du fichier → découpage → indexation
enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

// Contrôle d'un document avant qu'il serve aux chats (null = utilisable)
enum DocumentReview {
  TO_SORT // déposé dans « À trier » : Kingso doit le classer
  CONFIDENTIAL // dans Public mais semble confidentiel : en attente de validation
  IGNORED // écarté par l'équipe
}

// Rôles du back-office (cumulables) : Super admin = tout ; SAV = espace SAV ; Planning = interventions à planifier ;
// Technicien = espace SAV, affecté aux rendez-vous
enum UserRole {
  SUPER_ADMIN
  SAV
  PLANNING
  TECHNICIAN
}

// Public visé par un chat : un chat CLIENT ne lit jamais que les documents PUBLIC
enum AssistantAudience {
  CUSTOMER
  STAFF
}

enum AssistantAccess {
  PUBLIC
  PASSWORD
}

enum AssistantStatus {
  DRAFT
  ACTIVE
  DISABLED
}

model Category {
  id            String                 @id @default(cuid())
  name          String
  description   String?
  parentId      String?
  parent        Category?              @relation("SubCategories", fields: [parentId], references: [id])
  children      Category[]             @relation("SubCategories")
  createdAt     DateTime               @default(now())
  documents     Document[]
  faqs          Faq[]
  assistants    Assistant[]            @relation("AssistantCategories")
  driveMappings DriveCategoryMapping[]
}

model Document {
  id                String                       @id @default(cuid())
  title             String
  content           String
  type              DocumentType                 @default(PUBLIC)
  categoryId        String?
  category          Category?                    @relation(fields: [categoryId], references: [id])
  fileUrl           String? // ancien stockage public (documents créés avant l'import en masse)
  storagePath       String? // fichier original dans le bucket privé "document-files"
  fileName          String?
  mimeType          String?
  fileSize          Int?
  contentHash       String? // SHA-256 du fichier : détection des doublons
  pageCount         Int?
  status            DocumentStatus               @default(READY)
  statusMessage     String?
  // Synchronisation Google Drive : le fichier du Drive fait foi pour ce document
  driveFileId       String?                      @unique
  driveMd5          String? // empreinte Drive du fichier traité (null = à (re)télécharger)
  driveModifiedTime DateTime?
  drivePath         String? // emplacement dans le Drive, ex. « Public/PAC/Hitachi »
  reviewState       DocumentReview? // non nul = exclu des chats
  reviewNote        String? // raison de l'alerte (tarifs, données clients…)
  proposedPath      String? // rangement proposé par Kingso pour un document mis de côté
  classifiedAt      DateTime? // contrôle de confidentialité / classement fait pour cette version
  embedding         Unsupported("vector(1024)")? // obsolète : la recherche se fait sur DocumentChunk
  chunks            DocumentChunk[]
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@index([contentHash])
}

// Passage d'un document (~ une demi-page), indexé séparément pour une recherche précise
model DocumentChunk {
  id         String                       @id @default(cuid())
  documentId String
  document   Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  index      Int
  content    String
  pageStart  Int?
  pageEnd    Int?
  embedding  Unsupported("vector(1024)")?

  @@index([documentId])
}

model Faq {
  id         String    @id @default(cuid())
  question   String
  answer     String
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  published  Boolean   @default(false)
  order      Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model History {
  id               String     @id @default(cuid())
  sessionToken     String
  userMessage      String
  assistantMessage String
  documentsUsed    String[]
  assistantId      String?
  assistant        Assistant? @relation(fields: [assistantId], references: [id], onDelete: SetNull)
  attachments      String[] // chemins dans le bucket privé chat-attachments
  ipHash           String? // pour la limite de messages par visiteur
  rating           Int? // avis du client sur la réponse : 1 = 👍, -1 = 👎
  unanswered       Boolean    @default(false) // Kingso n'a pas trouvé la réponse dans la documentation
  reviewedAt       DateTime? // traité par l'équipe (page « À améliorer »)
  createdAt        DateTime   @default(now())

  @@index([sessionToken])
  @@index([assistantId, ipHash, createdAt])
}

// Dossier Google Drive synchronisé avec la base documentaire
model DriveSource {
  id             String    @id @default(cuid())
  name           String
  folderId       String    @unique // dossier ou Drive partagé racine (contient Public/, Interne/…)
  lastSyncAt     DateTime?
  lastSyncReport Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Correspondance nom de dossier Drive (2e niveau, ex. « PAC ») → catégorie Kingso,
// utilisée quand aucune catégorie ne porte exactement le nom du dossier
model DriveCategoryMapping {
  folderName String   @id // en minuscules
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

// Chaîne YouTube suivie : ses vidéos de dépannage deviennent des fiches pratiques (via « A trier »)
model VideoSource {
  id                String       @id @default(cuid())
  name              String
  channelId         String       @unique
  uploadsPlaylistId String
  url               String
  visibility        DocumentType @default(PUBLIC) // espace du Drive où déposer les fiches
  active            Boolean      @default(true)
  lastCheckedAt     DateTime?
  createdAt         DateTime     @default(now())
  videos            VideoItem[]
}

enum VideoStatus {
  TO_REVIEW // triée par Kingso, en attente de validation
  SELECTED // retenue : fiche à rédiger
  SKIPPED // écartée
  DONE // fiche déposée dans le Drive
  ERROR
}

model VideoItem {
  id          String      @id @default(cuid())
  sourceId    String
  source      VideoSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  videoId     String      @unique
  title       String
  description String      @default("")
  durationSec Int?
  publishedAt DateTime?
  relevant    Boolean? // avis de Kingso : aide au dépannage / à l'utilisation ?
  topic       String? // dépannage, entretien, réglage, installation, commercial…
  reason      String?
  status      VideoStatus @default(TO_REVIEW)
  note        String? // erreur éventuelle
  driveFileId String? // fiche déposée dans le Drive
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
}

// Journal des actions de la synchronisation Drive (récapitulatif du back-office)
model DriveEvent {
  id         String   @id @default(cuid())
  kind       String // SORTED, RENAMED, FAMILY_CREATED, CONFIDENTIAL, ERROR…
  title      String
  detail     String?
  documentId String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Titre résumé d'une conversation (généré par Claude), affiché dans l'historique du back-office
model ConversationSummary {
  sessionToken String   @id
  summary      String
  messageCount Int // nombre d'échanges pris en compte : régénéré quand la conversation avance
  updatedAt    DateTime @updatedAt
}

// Un chat configurable depuis le back-office, accessible sur /c/{slug}
model Assistant {
  id                 String            @id @default(cuid())
  slug               String            @unique
  previousSlugs      String[] // anciennes URLs, redirigées vers le slug actuel
  name               String
  status             AssistantStatus   @default(DRAFT)
  audience           AssistantAudience @default(CUSTOMER)
  access             AssistantAccess   @default(PUBLIC)
  accessPassword     String? // hash bcrypt
  welcomeMessage     String
  startButtons       String[]
  suggestedQuestions String[]
  instructions       String            @default("")
  categories         Category[]        @relation("AssistantCategories")
  webSources         WebSource[]       @relation("AssistantWebSources")
  escalationEnabled  Boolean           @default(false)
  escalationEmails   String[]
  attachmentsEnabled Boolean           @default(true)
  dailyMessageLimit  Int               @default(30)
  // Page d'accueil kingso.fr : le chat d'accueil (un seul) oriente vers les chats proposés
  isHome             Boolean           @default(false)
  showOnHome         Boolean           @default(false)
  homeTitle          String? // titre de la tuile, ex. « Ma pompe à chaleur »
  homeDescription    String? // ex. « Mise en route, code erreur, panne » — sert aussi à orienter les questions
  homeIcon           String? // emoji
  homeOrder          Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  histories          History[]
  escalations        Escalation[]
  savCases           SavCase[]
}

// Demande transmise au SAV depuis un chat
model Escalation {
  id           String    @id @default(cuid())
  assistantId  String
  assistant    Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  sessionToken String
  firstName    String
  lastName     String
  phone        String
  postalCode   String
  email        String?
  ipHash       String?
  emailSent    Boolean   @default(false)
  emailError   String?
  createdAt    DateTime  @default(now())

  @@index([sessionToken])
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  password       String? // connexion de secours ; les collaborateurs se connectent avec Google
  name           String?
  roles          UserRole[] @default([])
  active         Boolean    @default(true)
  /// Augmenté à chaque changement de rôles ou désactivation : les sessions ouvertes sont alors refusées
  sessionVersion Int        @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  technician     Technician?
}

enum TechnicianKind {
  SAV // technicien SAV : compte de connexion (Google ou mot de passe), voit tout l'espace SAV
  POSEUR // poseur (équipe chantier) : pas de compte, un lien personnel par intervention
}

/// Fiche d'un intervenant (technicien SAV ou poseur) : compétences, difficulté maximale, secteur, repérage dans l'agenda des chantiers
model Technician {
  id            String         @id @default(cuid())
  name          String
  kind          TechnicianKind @default(SAV)
  phone         String?
  /// Compte de connexion (techniciens SAV) ; les poseurs n'en ont pas
  userId        String?        @unique
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Compétences (clés de lib/sav/skills.ts : PAC, CLIM, CET, PV…)
  skills        String[]       @default([])
  /// Difficulté maximale (1 à 5) des interventions qu'il peut prendre ; null = pas de limite
  maxDifficulty Int?
  /// Secteur : départements, codes postaux ou communes, séparés par des virgules
  sector        String?
  /// Repères dans le titre des événements de l'agenda des chantiers (souvent les 3 premières lettres du prénom)
  agendaCodes   String[]       @default([])
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  cases         SavCase[]      @relation("SavTechnician")
}

/// Géocodage des adresses (API Adresse de l'État), gardé pour ne pas redemander : null = adresse introuvable
model GeoPoint {
  query     String   @id
  lat       Float?
  lng       Float?
  label     String?
  createdAt DateTime @default(now())
}

model WebSource {
  id          String      @id @default(cuid())
  name        String
  url         String      @unique
  maxPages    Int         @default(80)
  active      Boolean     @default(true)
  lastCrawled DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  pages       WebPage[]
  assistants  Assistant[] @relation("AssistantWebSources")
}

model WebPage {
  id        String                       @id @default(cuid())
  url       String                       @unique
  title     String
  content   String
  embedding Unsupported("vector(1024)")?
  sourceId  String
  source    WebSource                    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  crawledAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt
}

// ─── Espace SAV ─────────────────────────────────────────────────────────────
// Dossier SAV : une demande client (message du répondeur, demande depuis le chat, saisie manuelle),
// suivie jusqu'à sa résolution par Kingso ou par l'équipe.

enum SavSource {
  VOICEMAIL // message du répondeur (email Connectel)
  CHAT // formulaire « Transmettre au SAV » d'un chat
  MANUAL // créé dans le back-office
}

enum SavStatus {
  NEW // à traiter : email à valider
  WAITING // email envoyé ou programmé : en attente du client
  IN_CHAT // le client a ouvert son lien et échange avec Kingso
  TO_CALL // à rappeler par le SAV
  TO_SCHEDULE // intervention à planifier
  SCHEDULED // rendez-vous fixé
  TECH_REPORT // rendez-vous passé : retour du technicien attendu
  RESOLVED // résolu (par Kingso ou au téléphone)
  CLOSED // clos sans suite
}

enum SavCategory {
  SELF_HELP // Kingso peut aider le client à se dépanner
  INTERVENTION // fuite, électricité, pièce HS : intervention nécessaire
  ADMIN // entretien, contrat, administratif
  OTHER_PRODUCT // autre produit (solaire, chauffe-eau, clim…)
  UNCLEAR // message trop vague
}

model SavCase {
  id               String       @id @default(cuid())
  number           Int          @unique @default(autoincrement())
  source           SavSource
  status           SavStatus    @default(NEW)
  category         SavCategory  @default(UNCLEAR)
  urgent           Boolean      @default(false)
  urgentReason     String?
  /// Urgence de 1 (peut attendre) à 5 (tout de suite), proposée par Kingso, modifiable par tous ; 4 et plus = urgent
  urgency          Int?
  /// Difficulté de l'intervention de 1 (simple) à 5 (complexe), notée par l'équipe
  difficulty       Int?
  // Client (tel que compris dans le message, complété par le fichier client)
  phoneKey         String? // numéro normalisé (+33…) : regroupe les messages d'un même client
  callbackPhone    String?
  customerName     String?
  email            String?
  address          String?
  postalCode       String?
  city             String?
  clientId         String?
  client           SavClient?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientMatch      String? // comment le client a été identifié (ou pourquoi il ne l'a pas été)
  // Problème
  product          String? // PAC, CLIM, CET, PV, BATTERIE, AUTRE
  equipment        String? // ex. « PAC air-eau Hitachi Yutaki S Combi »
  summary          String       @default("")
  clientQuestion   String? // le problème dit par le client (1re personne) : démarre le chat personnel
  emailProblem     String? // pour l'email : « concernant l'erreur 83 sur votre pompe à chaleur »
  errorCode        String?
  noHeating        Boolean      @default(false) // pas de chauffage ni d'eau chaude : délais raccourcis
  // Chat personnel (lien envoyé au client)
  assistantId      String?
  assistant        Assistant?   @relation(fields: [assistantId], references: [id], onDelete: SetNull)
  accessToken      String       @unique
  tokenExpiresAt   DateTime
  chatSessionToken String?
  chatOpenedAt     DateTime?
  /// Première ouverture du lien personnel (page affichée dans un navigateur, pas un simple clic d'antivirus)
  linkOpenedAt     DateTime?
  /// Dernier signal de la page du client (envoyé toutes les 30 s tant qu'elle est ouverte et visible)
  lastSeenAt       DateTime?
  // Email au client
  emailTemplate    String?
  emailSubject     String?
  emailBody        String?
  emailScheduledAt DateTime?
  emailSentAt      DateTime?
  emailMessageId   String?
  emailError       String?
  // Planning
  planningEventId  String?
  planningDate     DateTime?
  appointmentAt    DateTime?
  appointmentMinutes Int? // durée de l'intervention (sinon la durée par défaut des réglages)
  technicianId     String?
  technician       Technician?  @relation("SavTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  /// Lien personnel de l'intervenant affecté (poseur sans compte) : /i/{techToken} ; changé quand l'intervenant change
  techToken        String?      @unique
  // Retour du technicien après l'intervention
  techOutcome      String? // RESOLVED, REVISIT, ABSENT, QUOTE
  techReport       String?
  techPhotos       String[]     @default([]) // chemins dans le stockage privé des photos
  techReportAt     DateTime?
  techReportBy     String?
  receivedAt       DateTime     @default(now())
  resolvedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  messages         SavMessage[]
  events           SavEvent[]

  @@index([status])
  @@index([phoneKey])
  @@index([appointmentAt])
}

// Message reçu (transcription du répondeur, demande du chat…)
model SavMessage {
  id          String    @id @default(cuid())
  caseId      String
  case        SavCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  source      SavSource
  externalId  String?   @unique // identifiant de l'email d'origine : jamais traité deux fois
  callerPhone String?
  durationSec Int?
  text        String
  photos      String[]  @default([]) // photos jointes par l'équipe (stockage privé), jamais montrées au client
  photoNote   String? // ce que Kingso a lu sur ces photos (code, marque, modèle…)
  receivedAt  DateTime
  createdAt   DateTime  @default(now())
}

// Historique du dossier (réception, email, chat, appels, notes…)
model SavEvent {
  id        String   @id @default(cuid())
  caseId    String
  case      SavCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind      String
  detail    String?
  author    String? // utilisateur du back-office, ou null pour Kingso
  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}

// Modèles d'email au client, par cas (modifiables dans le back-office)
model SavEmailTemplate {
  key       String   @id // SELF_HELP, FOLLOW_UP, INTERVENTION, ADMIN, OTHER_PRODUCT
  name      String
  subject   String
  body      String
  autoSend  Boolean  @default(false) // false = validation par l'équipe avant envoi
  updatedAt DateTime @updatedAt
}

// Fichier client (export Extrabat) : jamais accessible aux chats
model SavClient {
  id         String    @id @default(cuid())
  externalId String    @unique // identifiant client Extrabat
  name       String
  phones     String[] // normalisés (+33…)
  email      String?
  address    String?
  postalCode String?
  city       String?
  equipment  String? // résumé lisible des équipements installés
  contract   String? // contrat d'entretien
  importedAt DateTime  @default(now())
  cases      SavCase[]

  @@index([phones], type: Gin)
}

// Réglages généraux (clé → valeur JSON)
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
